# Run npm run setup to generate a random development pepper in .dev.vars.
ENVIRONMENT=development
# PASSWORD_PEPPER must be >=32 random characters; set with wrangler secret put in production.
PASSWORD_PEPPER=replace-with-a-random-secret-at-least-32-characters
# No frontend secrets and no cross-origin API URL are needed.
# GitHub deployment: CLOUDFLARE_API_TOKEN (secret) and CLOUDFLARE_ACCOUNT_ID (variable).
